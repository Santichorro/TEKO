{
  // Despliegue de TEKO en Cloudflare Workers (sitio estático, sin backend propio)
  "name": "teko",
  "compatibility_date": "2026-11-27",
  "assets": {
    "directory": "./dist",
    // Rutas como /proyectos/123 sirven index.html y React Router las resuelve
    "not_found_handling": "single-page-application"
  }
}
